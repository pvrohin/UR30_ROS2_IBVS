# Copy to .env (next to compose.yaml) and edit. .env is not committed: it is per machine.

# The image version to run: a release tag such as v0.2.0, never "latest".
IMAGE_TAG=v0.1.0

# The UR30's address on the robot network.
ROBOT_IP=192.168.56.101

# Must match on every computer that should see these topics (laptop, RViz, Foxglove).
ROS_DOMAIN_ID=30

# The robot's kinematics calibration, as seen INSIDE the container. Until ur_calibration has
# been run (docs/DEPLOYMENT.md, section 5.7), this is the nominal model shipped in the image:
# fine for bench tests, NOT accurate on a real arm. Afterwards: /etc/ur30/kinematics.yaml
KINEMATICS_FILE=/opt/ros/jazzy/share/ur_description/config/ur30/default_kinematics.yaml
