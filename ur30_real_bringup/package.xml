<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur30_real_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the real UR30 cell: UR driver, MoveIt Servo and Orbbec Gemini 335Lg. No simulator dependencies.</description>
  <maintainer email="pvrohin@gmail.com">pvrohin</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_client_library</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>ur30_cell_description</exec_depend>
  <exec_depend>ur30_cell_moveit_config</exec_depend>
  <exec_depend>ur30_ibvs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
