<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur30_cell_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro description of a UR30 workcell: pedestal, table, fixtured door panel, and eye-in-hand Orbbec Gemini 335Lg camera mount.</description>
  <maintainer email="pvrohin@gmail.com">pvrohin</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>orbbec_description</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
