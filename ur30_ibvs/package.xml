<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur30_ibvs</name>
  <version>0.1.0</version>
  <description>Image-based visual servoing (ViSP) of the UR30 eye-in-hand camera onto the door panel: detect, approach, then edge-track via MoveIt Servo.</description>
  <maintainer email="pvrohin@gmail.com">pvrohin</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visp</depend>
  <depend>OpenCV</depend>

  <exec_depend>ur30_cell_bringup</exec_depend>
  <exec_depend>ur30_cell_moveit_config</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
